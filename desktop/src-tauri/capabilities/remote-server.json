{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-server",
  "description": "Allow the selected server to cache rooms and request narrowly validated browser handoffs. Central login is additionally restricted in Rust to the loopback engine.",
  "windows": ["main", "room"],
  "local": false,
  "remote": {
    "urls": [
      "http://127.0.0.1:8765/*",
      "http://127.0.0.1:*/*",
      "http://localhost:*/*",
      "https://*/*"
    ]
  },
  "permissions": [
    "allow-cache-selected-room-directory",
    "allow-open-google-account-login",
    "allow-open-central-google-login"
  ]
}
