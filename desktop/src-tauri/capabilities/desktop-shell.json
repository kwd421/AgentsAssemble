{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-shell",
  "description": "Allow the bundled desktop connection screen to start and open the local room server.",
  "windows": ["main"],
  "local": true,
  "permissions": [
    "allow-client-platform",
    "allow-check-desktop-update",
    "allow-install-desktop-update",
    "allow-start-local-runtime",
    "allow-open-server",
    "allow-open-server-link",
    "allow-load-cached-room-directory",
    "core:event:default"
  ]
}
