{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile-shell",
  "description": "Allow the bundled mobile connection screen to reopen cached rooms and scan a room or recovery QR code.",
  "windows": ["main"],
  "platforms": ["iOS", "android"],
  "local": true,
  "permissions": [
    "allow-client-platform",
    "allow-open-server",
    "allow-open-server-link",
    "allow-load-cached-room-directory",
    "barcode-scanner:allow-check-permissions",
    "barcode-scanner:allow-request-permissions",
    "barcode-scanner:allow-open-app-settings",
    "barcode-scanner:allow-scan",
    "barcode-scanner:allow-cancel"
  ]
}
