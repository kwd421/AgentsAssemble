{
  "room_id": "general",
  "providers": [
    {
      "id": "codex",
      "kind": "live_cli",
      "display_name": "Codex CLI",
      "command": [
        "codex",
        "--no-alt-screen",
        "--ask-for-approval",
        "never",
        "--sandbox",
        "read-only",
        "-C",
        "."
      ],
      "cwd": ".",
      "input_mode": "bracketed_paste",
      "submit_newline": "\r",
      "terminal_columns": 120,
      "terminal_rows": 40,
      "initial_prompt_args": ["{prompt}"],
      "startup_wait_seconds": 2,
      "quiet_seconds": 4,
      "session_probe_prompt": "AGENTSASSEMBLE_SESSION_MARKER=codex-001 를 기억하고 codex-001 이라고만 답해.",
      "memory_check_prompt": "아까 내가 준 AGENTSASSEMBLE_SESSION_MARKER 값을 말해줘. marker 값만 답해."
    },
    {
      "id": "antigravity",
      "kind": "live_cli",
      "display_name": "Antigravity CLI",
      "command": [
        "/Users/seinel/.local/bin/agy",
        "--dangerously-skip-permissions"
      ],
      "cwd": ".",
      "input_mode": "bracketed_paste",
      "submit_newline": "\r",
      "terminal_columns": 120,
      "terminal_rows": 40,
      "initial_prompt_args": ["--prompt-interactive", "{prompt}"],
      "startup_accept_contains": "Do you trust the contents of this project?",
      "startup_accept_keys": "\r",
      "startup_after_accept_wait_seconds": 2,
      "quiet_seconds": 4,
      "session_probe_prompt": "AGENTSASSEMBLE_SESSION_MARKER=antigravity-001 를 기억하고 antigravity-001 이라고만 답해.",
      "memory_check_prompt": "아까 marker 값 뭐였지? marker 값만 답해."
    },
    {
      "id": "grok",
      "kind": "live_cli",
      "display_name": "Grok CLI",
      "command": [
        "grok",
        "--no-alt-screen",
        "--always-approve",
        "--cwd",
        "."
      ],
      "cwd": ".",
      "submit_newline": "\r",
      "terminal_columns": 120,
      "terminal_rows": 40,
      "startup_wait_seconds": 1,
      "quiet_seconds": 4,
      "session_probe_prompt": "AGENTSASSEMBLE_SESSION_MARKER=grok-001 를 기억하고 grok-001 이라고만 답해.",
      "memory_check_prompt": "아까 marker 값 뭐였지? marker 값만 답해."
    }
  ]
}
