{
  "description": "Block one-shot provider commands that bypass canonical Agent Sessions.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/block_provider_print.py\"",
            "timeout": 5,
            "statusMessage": "Checking provider launch mode"
          }
        ]
      }
    ]
  }
}
